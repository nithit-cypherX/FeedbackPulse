# For Local development configuration (no real secrets committed)

# SERVICE_TOKEN is required: supply a private random value at runtime.
# Missing or blank SERVICE_TOKEN prevents startup. Do not commit the real value.
SERVICE_TOKEN=YOUR_SERVICE_TOKEN_HERE
# Local packaged model path; leave MODEL_DIR unset to use the default artifact path.
# API startup does not download models. Prepare the artifact through P02 first.
MODEL_DIR=YOUR_MODEL_DIRECTORY_HERE
MODEL_VERSION=YOUR_MODEL_VERSION_HERE
HOST=127.0.0.1
PORT=8000
