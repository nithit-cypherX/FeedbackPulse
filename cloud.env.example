# Cloud deployment configuration template (Azure Container Apps)
# Copy to cloud.env for manual deployment and fill every required value.
# No resources or permissions are created by this example.
# In GitHub CD, target values are repository variables; login IDs and
# SERVICE_TOKEN are production Environment secrets. Keep the CD switch off
# until resource setup, permissions and the workflow diff have been reviewed.

# Azure Resource Group & Region
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=

# Azure Container Apps Environment & Service
AZURE_CONTAINER_APP_ENV=
AZURE_CONTAINER_APP_NAME=

# Azure Container Registry (ACR)
AZURE_REGISTRY_NAME=
AZURE_REGISTRY_SERVER=
# Full resource ID of a separate image-pull identity, not the CD client ID.
# Provision it and grant AcrPull on the intended ACR before deploying.
AZURE_REGISTRY_IDENTITY_ID=
IMAGE_TAG=

# Application runtime & secrets
SERVICE_TOKEN=
HOST=0.0.0.0
PORT=8000
MODEL_DIR=/app/artifacts/sentiment-6e7ff9fbc17c/model
MODEL_VERSION=sentiment-6e7ff9fbc17c-0110c462
