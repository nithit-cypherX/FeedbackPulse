# Cloud deployment configuration template (Azure Container Apps)
# In production, SERVICE_TOKEN is provided via Azure Key Vault or Container Apps secret.

# ALL env have automatic fallbacks if it didnt have been defined.
SERVICE_TOKEN=YOUR_PRODUCTION_SERVICE_TOKEN_HERE
MODEL_DIR=YOUR_MODEL_DIRECTORY_HERE
MODEL_VERSION=YOUR_MODEL_VERSION_HERE
HOST=0.0.0.0
PORT=8000
