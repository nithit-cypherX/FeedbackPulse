# Cloud deployment configuration template (Azure Container Apps)
# In production, SERVICE_TOKEN is provided via Azure Key Vault or Container Apps secret.

# Azure Resource Group & Region
AZURE_RESOURCE_GROUP=itcs355-6688166
AZURE_LOCATION=eastasia

# Azure Container Apps Environment & Service
AZURE_CONTAINER_APP_ENV=itcs355-env
AZURE_CONTAINER_APP_NAME=feedbackpulse-api

# Azure Container Registry (ACR)
AZURE_REGISTRY_NAME=YOUR_REGISTRY_NAME_HERE
AZURE_REGISTRY_SERVER=YOUR_REGISTRY_SERVER_HERE
IMAGE_TAG=YOUR_IMAGE_TAG_HERE

# Application runtime & secrets
SERVICE_TOKEN=YOUR_PRODUCTION_SERVICE_TOKEN_HERE
HOST=0.0.0.0
PORT=8000
MODEL_DIR=/app/artifacts/sentiment-6e7ff9fbc17c/model
MODEL_VERSION=sentiment-6e7ff9fbc17c-0110c462
