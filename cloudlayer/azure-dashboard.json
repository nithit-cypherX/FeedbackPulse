              "settings": {
                "content": {
                  "content": "Metrics cover the whole App, not only `/predict`. Response time is an **average (Preview)**, not p95 or browser round-trip time.\n\nErrors are request counts split into **4xx** and **5xx**. An absent series means no data was returned for that category; it is not a fabricated zero. Use the same time range for all charts.\n\nMonitoring data can arrive after a delay. Refresh manually; **no alert is configured in this step**.",
                  "title": "Reading this dashboard",
                  "subtitle": "feedbackpulse-api · Malaysia West",
                  "markdownSource": 1,
                  "markdownUri": ""
                }
              }
            }
          }
